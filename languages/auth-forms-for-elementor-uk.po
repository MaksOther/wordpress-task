#: ajax/class-afe-ajax-login.php:41
msgid "Invalid login or password."
msgstr "Невірний логін або пароль."

#: ajax/class-afe-ajax-login.php:51
msgid "You have logged in successfully."
msgstr "Ви успішно увійшли."

#: ajax/class-afe-ajax-lost-password.php:24
msgid "The email could not be sent. Please try again later or contact the site administrator."
msgstr "Не вдалося надіслати лист. Спробуйте пізніше або зверніться до адміністратора сайту."

#: ajax/class-afe-ajax-lost-password.php:27
#: includes/functions.php:162
msgid "If an account with these details exists, a password reset link has been sent to its email address."
msgstr "Якщо обліковий запис із такими даними існує, на його email надіслано посилання для скидання пароля."

#: ajax/class-afe-ajax-register.php:13
#: includes/functions.php:127
msgid "User registration is currently not allowed."
msgstr "Реєстрація користувачів наразі вимкнена."

#: ajax/class-afe-ajax-register.php:60
msgid "Registration complete. You can now log in."
msgstr "Реєстрацію завершено. Тепер ви можете увійти."

#: ajax/class-afe-ajax-register.php:67
msgid "Registration complete."
msgstr "Реєстрацію завершено."

#: ajax/class-afe-ajax-register.php:74
msgid "Please enter your first name."
msgstr "Введіть ім’я."

#: ajax/class-afe-ajax-register.php:78
msgid "Please enter your last name."
msgstr "Введіть прізвище."

#: ajax/class-afe-ajax-register.php:82
msgid "Please enter a valid email address."
msgstr "Введіть коректну email-адресу."

#: ajax/class-afe-ajax-register.php:84
msgid "This email address is already registered."
msgstr "Ця email-адреса вже зареєстрована."

#: ajax/class-afe-ajax-register.php:90
msgid "Please enter a username."
msgstr "Введіть ім’я користувача."

#: ajax/class-afe-ajax-register.php:92
msgid "The username may only contain Latin letters, numbers, spaces and the characters _ . - @"
msgstr "Ім’я користувача може містити лише латинські літери, цифри, пробіли та символи _ . - @"

#: ajax/class-afe-ajax-register.php:94
msgid "The username may not be longer than 60 characters."
msgstr "Ім’я користувача не може бути довшим за 60 символів."

#: ajax/class-afe-ajax-register.php:96
msgid "Sorry, that username is not allowed."
msgstr "На жаль, це ім’я користувача заборонене."

#: ajax/class-afe-ajax-register.php:98
msgid "This username is already taken."
msgstr "Це ім’я користувача вже зайняте."

#: ajax/class-afe-ajax-register.php:104
msgid "Please enter a password."
msgstr "Введіть пароль."

#: ajax/class-afe-ajax-register.php:118
msgid "The passwords do not match."
msgstr "Паролі не збігаються."

#: ajax/class-afe-ajax-register.php:107
msgid "The password must be at least %d character long."
msgid_plural "The password must be at least %d characters long."
msgstr[0] "Пароль має містити щонайменше %d символ."
msgstr[1] "Пароль має містити щонайменше %d символи."
msgstr[2] "Пароль має містити щонайменше %d символів."

#: ajax/class-afe-ajax.php:22
msgid "You are already logged in."
msgstr "Ви вже увійшли."

#: ajax/class-afe-ajax.php:29
msgid "Security check failed. Please refresh the page and try again."
msgstr "Перевірку безпеки не пройдено. Оновіть сторінку та спробуйте ще раз."

#: ajax/class-afe-ajax.php:33
msgid "reCAPTCHA verification failed. Please try again."
msgstr "Перевірку reCAPTCHA не пройдено. Спробуйте ще раз."

#: classes/class-afe-assets.php:41
msgid "Something went wrong. Please try again."
msgstr "Щось пішло не так. Спробуйте ще раз."

#: classes/class-afe-assets.php:42
msgid "Forms are not submitted in the editor preview."
msgstr "У режимі редактора форми не надсилаються."

#: classes/class-afe-plugin.php:56
msgid "Auth Forms for Elementor requires Elementor to be installed and activated."
msgstr "Для роботи Auth Forms for Elementor потрібно встановити та активувати Elementor."

#: classes/class-afe-plugin.php:62
msgid "Auth Forms for Elementor requires Elementor version %s or newer."
