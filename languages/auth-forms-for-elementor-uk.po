#: ajax/class-afe-ajax-login.php:18
#: ajax/class-afe-ajax-lost-password.php:17
msgid "Please enter your email or username."
msgstr "Введіть email або ім’я користувача."

#: ajax/class-afe-ajax-login.php:22
msgid "Please enter your password."
msgstr "Введіть пароль."

#: ajax/class-afe-ajax-login.php:26
#: ajax/class-afe-ajax-lost-password.php:16
#: ajax/class-afe-ajax-register.php:26
msgid "Please fix the errors below."
